DJANGO_SECRET_KEY=troque_por_uma_chave_segura
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,.ondigitalocean.app
DJANGO_CSRF_TRUSTED_ORIGINS=https://*.ondigitalocean.app
# URL pública exata da app (links nos e-mails de convite e recuperação de palavra-passe)
# PUBLIC_SITE_URL=https://gol-health-xxxxx.ondigitalocean.app

# Em produção na DigitalOcean, o DATABASE_URL vem do banco gerenciado.
# Exemplo local opcional:
# DATABASE_URL=postgresql://usuario:senha@localhost:5432/gol_health

# E-mail (obrigatório em produção para MFA e notificações).
# Em desenvolvimento (DEBUG=True) sem EMAIL_HOST, o Django usa o backend console.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.exemplo.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=utilizador@exemplo.com
# EMAIL_HOST_PASSWORD=senha
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=noreply@gol-health.pt
